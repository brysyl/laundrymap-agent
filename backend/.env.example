# Backend environment for running outside Docker (npm run dev --workspace=backend).
# Copy to backend/.env and export the values in your shell; the server reads process.env only.
# Definitions and validation live in backend/src/config.ts.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Optional in development: without them the server uses the in-memory store and cache.
# In production both are required and must use TLS (sslmode=require, rediss://).
DATABASE_URL=
REDIS_URL=

# Two different values, at least 32 characters each (enforced in production).
JWT_SECRET=<generate-with-openssl>
OTP_ENCRYPTION_KEY=<generate-with-openssl>
JWT_TTL_SECONDS=43200

PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# Comma separated https origins added to https://laundrymap.ng and https://api.laundrymap.ng.
CORS_EXTRA_ORIGINS=
# Number of reverse proxy hops in front of the API (1 on Render).
TRUST_PROXY=0

# Pricing, all amounts in integer kobo; fees in basis points.
PLATFORM_FEE_BPS=1000
DELIVERY_FEE_KOBO=100000
GATEWAY_BPS=150
GATEWAY_FLAT_KOBO=10000
GATEWAY_FLAT_THRESHOLD_KOBO=250000
GATEWAY_CAP_KOBO=200000

VENDOR_ACCEPT_TIMEOUT_MS=120000
WORKER_INTERVAL_MS=5000
# Failed or unsubmitted gateway refunds are retried by the worker once they are this old.
REFUND_RETRY_MIN_AGE_MS=60000
OTP_TTL_MS=21600000
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MS=900000
COURIER_LOCATION_MIN_INTERVAL_MS=3000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

SEED_DEMO=false
# Set all three together to create an admin on startup. Password at least 12 characters.
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
