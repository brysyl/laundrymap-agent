# Frontend environment. Copy to frontend/.env.local (git-ignored) for local work,
# or set in the Vercel project settings. NEXT_PUBLIC_* values are embedded in the
# browser bundle and in the CSP connect-src at build time, so never put secrets here.

# Server-side rewrite target for /api/* (same-origin API calls in dev).
API_PROXY_TARGET=http://localhost:4000
# Browser-visible API origin. Production: https://api.laundrymap.ng
NEXT_PUBLIC_API_URL=
# Socket.IO origin. Defaults to NEXT_PUBLIC_API_URL when empty.
NEXT_PUBLIC_SOCKET_URL=
