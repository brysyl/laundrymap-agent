# Used by docker-compose.yml. Copy to .env (git-ignored) and fill in values.
# Generate secrets with: openssl rand -base64 48
POSTGRES_USER=laundrymap
POSTGRES_PASSWORD=<set-a-strong-password>
POSTGRES_DB=laundrymap
REDIS_PASSWORD=<set-a-strong-password>

# Must be two different values, at least 32 characters each.
JWT_SECRET=<generate-with-openssl>
OTP_ENCRYPTION_KEY=<generate-with-openssl>

# Paystack test key for local work (sk_test_...). Live key only in the host's secret store.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
CORS_EXTRA_ORIGINS=http://localhost:3000
SEED_DEMO=false
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
